# ==========================================================
# 1. AI API 키 설정 (Gemini 권장 - 무료 티어 사용 가능)
# Google AI Studio (https://aistudio.google.com/app/apikey) 에서 발급
# ==========================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# (선택) OpenAI API 키를 사용할 경우 아래에 입력 (GEMINI_API_KEY가 있으면 Gemini 우선 사용)
OPENAI_API_KEY=

# ==========================================================
# 2. Firebase Firestore 설정 (택 1)
# 방법 A: 서비스 계정 JSON 파일 경로 지정 (로컬 개발 시 편리)
# 방법 B: 서비스 계정 JSON 문자열 전체를 한 줄로 입력 (Render 배포 시 권장)
# ==========================================================
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_JSON=

# ==========================================================
# 3. 서버 및 CORS 설정
# ==========================================================
ALLOWED_ORIGINS=*
PORT=8000
API_BASE_URL=http://localhost:8000

